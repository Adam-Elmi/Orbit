{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Orbit",
  "version": "1.0.0",
  "identifier": "com.adamelmi.orbit",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run watch",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Orbit",
        "width": 360,
        "height": 560,
        "minWidth": 240,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "A calculator with sessions you slide between",
    "longDescription": "Orbit keeps several calculations open at once, each in its own session. Swipe or press Ctrl+1, Ctrl+2 to move between them. Every session keeps its numbers and history, even after you close Orbit.",
    "publisher": "Adam Elmi",
    "copyright": "© 2026 Adam Elmi",
    "homepage": "https://github.com/Adam-Elmi/Orbit"
  }
}
