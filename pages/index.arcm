# ###################
# Orbit: the one page
# Sessions you slide between, each with its line and live result; history and settings panels
# ###################
[import = Keypad: "@/components/Keypad.arcm" !]

${
  // the logo for the top bar, without the file's metadata block
  import { readFileSync } from "node:fs";
  const logo = readFileSync(new URL("../orbit-logo.svg", import.meta.url), "utf8").replace(/<metadata>[\s\S]*?<\/metadata>/, "");
  // the about card's version, from package.json, so it never goes stale
  const { version } = JSON.parse(readFileSync(new URL("../package.json", import.meta.url), "utf8"));
  const REPO = "https://github.com/Adam-Elmi/Orbit";
  // every shortcut, for the keyboard panel (keys: what to press, each a <kbd>)
  const shortcuts = [
    { group: "Calculator", items: [
      { keys: ["0–9", "."], does: "Type a number" },
      { keys: ["+", "−", "×", "÷"], does: "Operators (also - * x /)" },
      { keys: ["%"], does: "Percent: 50% = 0.5, 200 + 10% = 220" },
      { keys: ["(", ")"], does: "Brackets" },
      { keys: ["Enter"], does: "Put the result in the line (or =)" },
      { keys: ["Backspace"], does: "Delete one character" },
      { keys: ["Esc"], does: "Clear the line (or Delete)" }
    ] },
    { group: "Sessions", items: [
      { keys: ["Ctrl", "T"], does: "New session" },
      { keys: ["Ctrl", "W"], does: "Close session (the last one only clears)" },
      { keys: ["Ctrl", "1–9"], does: "Go to session 1–9" },
      { keys: ["Ctrl", "←", "→"], does: "Previous / next session" },
      { keys: ["Swipe"], does: "Two fingers sideways: previous / next" }
    ] },
    { group: "App", items: [
      { keys: ["Esc"], does: "Close a panel, settings or the about card" },
      { keys: ["Ctrl", "Q"], does: "Quit Orbit" }
    ] }
  ];
  // the settings panel's choices (the same lists as src/lib/settings.js)
  const decimalChoices = ["auto", 2, 4, 6, 10];
}$

runtime ${
  import { signal, computed, effect } from "arcmoon/reactive";
  import { calc } from "../src/lib/calc.js";
  import { MAX_SESSIONS, blank, load, save } from "../src/lib/sessions.js";
  import { loadSettings, saveSettings } from "../src/lib/settings.js";

  // ###################
  // Settings: decimals and how sessions show (dots or numbers), saved on every change
  // ###################
  const settings = signal(loadSettings());
  effect(() => saveSettings(settings()));
  const setSetting = (part) => settings({ ...settings(), ...part });

  // ###################
  // Sessions: each has the line being typed (with × ÷ −), and its history [{ line, result }] for the history panel
  // They start as they were saved, and are saved again on every change
  // ###################
  const saved = load();
  const sessions = signal(saved.sessions);
  const current = signal(saved.current);
  effect(() => save({ sessions: sessions(), current: current() }));

  const now = () => sessions()[current()];
  const change = (part) => sessions(sessions().map((s, i) => (i === current() ? { ...s, ...part } : s)));

  // ###################
  // Moving between sessions. No batch in arcmoon/reactive, and effects run on every set:
  // current is set first when it goes down, so it never points past the list
  // ###################
  const go = (i) => current(Math.max(0, Math.min(sessions().length - 1, i)));
  const open = () => {
    if (sessions().length >= MAX_SESSIONS) return;
    sessions([...sessions(), blank()]);
    current(sessions().length - 1);
  };
  const close = () => {
    if (sessions().length === 1) return sessions([blank()]);   // the last one only clears
    const at = current();
    current(Math.min(at, sessions().length - 2));
    sessions(sessions().filter((_, i) => i !== at));
  };

  // ###################
  // The current session's line
  // ###################
  const input = () => now().input;
  const setInput = (line) => change({ input: line });

  // results use the same − as the keypad, so going on from one reads the same
  const work = (line) => calc(line, { decimals: settings().decimals })?.replace(/^-/, "−") ?? null;
  const result = computed(() => work(input()));

  // just a number (453, −2.5, 1.5e+21): no result line, and Enter keeps nothing in history
  const isPlain = (line) => /^−?[0-9.]+(e[+-][0-9]+)?$/.test(line);

  const OPERATORS = "+−×÷";
  const last = () => input().slice(-1);

  // 2×−3 reads better with spaces: "2 × −3"
  const show = (line) => line.replace(/([0-9.%)])([+−×÷])/g, "$1 $2 ");

  // ###################
  // One key, from the keypad or the keyboard
  // Enter puts the result in the line (23÷2 → 11.5); a real calculation also goes to history
  // After Enter, a digit starts a new line and an operator goes on from the result
  // ###################
  const press = (key) => {
    if (key === "=") {
      if (!input() || result() === null) return;
      const line = input();
      // a plain number stays as typed (7, not 7.0000 with 4 decimals)
      if (isPlain(line)) return change({ done: true });
      return change({ input: result(), done: true, lines: [...now().lines, { line, result: result() }] });
    }
    if (key === "C") return change({ input: "", done: false });
    if (key === "⌫") return change({ input: input().slice(0, -1), done: false });
    if (now().done && !OPERATORS.includes(key) && key !== "%") return change({ input: key, done: false });
    if (OPERATORS.includes(key)) {
      if (!input()) return key === "−" ? setInput(key) : undefined;
      // − after × ÷ ( starts a negative number; any other operator replaces the one before it
      if (key === "−" && "×÷(".includes(last())) return change({ input: input() + key, done: false });
      if (OPERATORS.includes(last())) return change({ input: input().slice(0, -1) + key, done: false });
    }
    change({ input: input() + key, done: false });
  };

  // ###################
  // The window (Tauri): minimize and close; in a plain browser there's no window to control
  // ###################
  const win = window.__TAURI__?.window.getCurrentWindow() ?? null;
  const minimize = () => win?.minimize();
  const quit = () => win?.close();
  document.documentElement.toggleAttribute("data-tauri", win !== null);

  // ###################
  // Keyboard panel, history panel or settings page, one at a time
  // All close with their icon or Esc; the two panels also with a click outside them
  // ###################
  const panelOpen = signal(null);
  const toggleKeys = () => panelOpen(panelOpen() === "keys" ? null : "keys");
  const toggleHistory = () => panelOpen(panelOpen() === "history" ? null : "history");
  const toggleSettings = () => panelOpen(panelOpen() === "settings" ? null : "settings");
  const closePanel = () => panelOpen(null);

  // ###################
  // About: the logo opens a card; ×, Esc or a click outside closes it
  // Links open in the browser: Tauri's opener, or a new tab in a plain browser
  // ###################
  const aboutOpen = signal(false);
  const purposeOpen = signal(false);   // the purpose's longer text, behind "Read more"
  const togglePurpose = () => purposeOpen(!purposeOpen());
  const openAbout = () => aboutOpen(true);
  const closeAbout = () => {
    aboutOpen(false);
    purposeOpen(false);
  };
  const outsideAbout = (e) => {
    if (e.target === e.currentTarget) closeAbout();
  };
  const openLink = (e) => {
    const opener = window.__TAURI__?.opener;
    if (!opener) return;   // the browser follows target="_blank" itself
    e.preventDefault();
    opener.openUrl(e.currentTarget.href);
  };
  document.addEventListener("pointerdown", (e) => {
    if (panelOpen() && panelOpen() !== "settings" && !e.target.closest(".panel, [data-panel-button]")) panelOpen(null);
  });

  // ###################
  // History: the current session's calculations, newest first; click one to use its result
  // ###################
  const clearHistory = () => change({ lines: [] });
  const useLine = (e) => {
    const item = e.target.closest("[data-at]");
    if (!item) return;
    change({ input: now().lines[Number(item.dataset.at)].result, done: true });
    panelOpen(null);
  };

  // ###################
  // Settings page: the choices carry their value in data- (build-time loop names don't reach the browser)
  // Each card has a preview: sample results, the indicator styles, what Clear all removes
  // ###################
  const sample = (line) => work(line) ?? "";
  const plural = (n, word) => `${n} ${word}${n === 1 ? "" : "s"}`;
  const clearStats = () => `${plural(sessions().length, "session")} · ${plural(sessions().reduce((n, s) => n + s.lines.length, 0), "calculation")}`;
  const pickDecimals = (e) => {
    const value = e.target.closest("[data-decimals]")?.dataset.decimals;
    if (value !== undefined) setSetting({ decimals: value === "auto" ? "auto" : Number(value) });
  };
  const pickIndicator = (e) => {
    const value = e.target.closest("[data-indicator]")?.dataset.indicator;
    if (value) setSetting({ indicator: value });
  };

  // Clear all: the first click asks, a second one within 3 s clears
  const armed = signal(false);
  let disarm = null;
  const clearAll = () => {
    clearTimeout(disarm);
    if (!armed()) {
      armed(true);
      disarm = setTimeout(() => armed(false), 3000);
      return;
    }
    armed(false);
    current(0);
    sessions([blank()]);
  };

  // ###################
  // The keyboard. Ctrl: 1–9 go to a session, ← → move, T opens, W closes, Q quits
  // ###################
  const KEYBOARD = { "-": "−", "*": "×", x: "×", "/": "÷", ",": ".", Enter: "=", Backspace: "⌫", Escape: "C", Delete: "C" };
  window.addEventListener("keydown", (e) => {
    if (e.altKey || e.metaKey) return;
    if (e.ctrlKey) {
      const k = e.key.toLowerCase();
      const act = /^[1-9]$/.test(k) ? () => go(Number(k) - 1)
        : k === "arrowleft" ? () => go(current() - 1)
        : k === "arrowright" ? () => go(current() + 1)
        : k === "t" ? open
        : k === "w" ? close
        : k === "q" ? quit
        : null;
      if (act) {
        e.preventDefault();
        act();
      }
      return;
    }
    if (e.key === "Escape" && aboutOpen()) {
      e.preventDefault();
      return closeAbout();
    }
    if (e.key === "Escape" && panelOpen()) {
      e.preventDefault();
      return panelOpen(null);
    }
    const key = KEYBOARD[e.key] ?? e.key;
    if (!/^[0-9.%()+−×÷=C⌫]$/.test(key) || (key === "C" && e.key === "C")) return;
    e.preventDefault();
    press(key);
  });

  // ###################
  // Two-finger swipe (sideways wheel): one session per swipe, then wait for the swipe to end
  // ###################
  let swiped = 0;
  let resting = null;
  const swipe = (e) => {
    if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;   // only sideways swipes move between sessions
    e.preventDefault();
    clearTimeout(resting);
    resting = setTimeout(() => (swiped = 0), 200);
    if (swiped === Infinity) return;
    swiped += e.deltaX;
    if (Math.abs(swiped) > 60) {
      go(current() + Math.sign(swiped));
      swiped = Infinity;
    }
  };

  // ###################
  // Panels: one per session, cloned from the [template] (no live [for-each] yet);
  // the track slides so the current one shows
  // ###################
  const track = ArcMoon.ref(ArcMoon.defineRef("track"));
  const panel = ArcMoon.ref(ArcMoon.defineRef("panel"));
  track.addEventListener("wheel", swipe, { passive: false });

  const fill = (el, session, isCurrent) => {
    const value = work(session.input);
    el.querySelector(".line-text").textContent = show(session.input) || "0";
    el.querySelector(".result-text").textContent = value ?? "";
    el.toggleAttribute("data-empty", session.input === "");
    // the result shows only when it says something new: not for 453, not after Enter
    el.toggleAttribute("data-show", value !== null && !isPlain(session.input));
    el.toggleAttribute("data-current", isCurrent);
  };

  effect(() => {
    const list = sessions();
    const at = current();
    while (track.childElementCount < list.length) track.append(panel.content.firstElementChild.cloneNode(true));
    while (track.childElementCount > list.length) track.lastElementChild.remove();
    list.forEach((session, i) => fill(track.children[i], session, i === at));
    track.style.transform = `translateX(${-at * 100}%)`;
  });
  // slide only after the first draw, so launching on session 3 doesn't slide there from session 1
  requestAnimationFrame(() => requestAnimationFrame(() => track.setAttribute("data-ready", "")));

  // ###################
  // Sessions under the display: dots or numbers (a setting), the current one in mint; click to go there
  // ###################
  const dots = ArcMoon.ref(ArcMoon.defineRef("dots"));
  effect(() => {
    const at = current();
    const numbers = settings().indicator === "numbers";
    dots.replaceChildren(
      ...sessions().map((_, i) => {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.tabIndex = -1;
        dot.className = numbers ? "num" : "dot";
        dot.textContent = numbers ? String(i + 1) : "";
        dot.dataset.at = i;
        dot.toggleAttribute("data-current", i === at);
        dot.setAttribute("aria-label", `Session ${i + 1}`);
        return dot;
      })
    );
  });

  // ###################
  // Settings page: mark the chosen decimals and indicator style
  // ###################
  const choices = ArcMoon.ref(ArcMoon.defineRef("settingsPanel"));
  effect(() => {
    const { decimals, indicator } = settings();
    for (const b of choices.querySelectorAll("[data-decimals]")) b.toggleAttribute("data-active", b.dataset.decimals === String(decimals));
    for (const b of choices.querySelectorAll("[data-indicator]")) b.toggleAttribute("data-active", b.dataset.indicator === indicator);
  });

  // ###################
  // The history list, redrawn for the current session (no live [for-each] yet)
  // ###################
  const historyList = ArcMoon.ref(ArcMoon.defineRef("historyList"));
  effect(() => {
    historyList.replaceChildren(
      ...now()
        .lines.map(({ line, result }, i) => {
          const item = document.createElement("li");
          const button = document.createElement("button");
          const expr = document.createElement("span");
          const value = document.createElement("span");
          button.type = "button";
          button.tabIndex = -1;
          button.dataset.at = i;
          expr.className = "h-line";
          value.className = "h-result";
          expr.textContent = show(line);
          value.textContent = `= ${result}`;
          button.append(expr, value);
          item.append(button);
          return item;
        })
        .reverse()
    );
    historyList.scrollTop = 0;
  });
}$

[doctype!]
[html = lang: "en"]
  [head]
    [meta = charset: "utf-8" !]
    [meta = name: "viewport", content: "width=device-width, initial-scale=1" !]
    [title]Orbit[end]
  [end:head]
  [body]
    [main = class: "app"]
      # frameless window: this bar moves it (data-tauri-drag-region): logo, toolbar, window buttons
      [header = class: "bar", data-tauri-drag-region: true]
        [button = class: "logo", type: "button", tabindex: "-1", aria-label: "About Orbit", title: "About Orbit", onclick: runtime ${ openAbout }$]${ { raw: logo } }$[end]
        [span = class: "grow", data-tauri-drag-region: true][end]
        [div = class: "tools"]
          [button = class: "tool", type: "button", tabindex: "-1", aria-label: "Keyboard shortcuts", title: "Keyboard shortcuts", data-panel-button: true, data-active: runtime ${ panelOpen() === "keys" }$, onclick: runtime ${ toggleKeys }$]
            [svg = viewBox: "0 0 24 24", aria-hidden: "true"]
              [rect = x: "2", y: "4", width: "20", height: "16", rx: "2" !]
              [path = d: "M6 8h.01M10 8h.01M14 8h.01M18 8h.01M8 12h.01M12 12h.01M16 12h.01M7 16h10" !]
            [end:svg]
          [end:button]
          [button = class: "tool", type: "button", tabindex: "-1", aria-label: "History", title: "History", data-panel-button: true, data-active: runtime ${ panelOpen() === "history" }$, onclick: runtime ${ toggleHistory }$]
            [svg = viewBox: "0 0 24 24", aria-hidden: "true"]
              [path = d: "M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" !]
              [path = d: "M3 3v5h5" !]
              [path = d: "M12 7v5l4 2" !]
            [end:svg]
          [end:button]
          [button = class: "tool", type: "button", tabindex: "-1", aria-label: "Settings", title: "Settings", data-panel-button: true, data-active: runtime ${ panelOpen() === "settings" }$, onclick: runtime ${ toggleSettings }$]
            [svg = viewBox: "0 0 24 24", aria-hidden: "true"]
              [path = d: "M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" !]
              [circle = cx: "12", cy: "12", r: "3" !]
            [end:svg]
          [end:button]
        [end:div]
        [div = class: "window"]
          [button = class: "win", type: "button", tabindex: "-1", aria-label: "Minimize", onclick: runtime ${ minimize }$]–[end]
          [button = class: "win close", type: "button", tabindex: "-1", aria-label: "Close", onclick: runtime ${ quit }$]×[end]
        [end:div]
      [end:header]
      [div = class: "viewport"]
        [div = class: "track", arcm-ref: "track"][end]
      [end]
      [nav = class: "dots", arcm-ref: "dots", onclick: runtime ${ (e) => { const dot = e.target.closest("[data-at]"); if (dot) go(Number(dot.dataset.at)); } }$][end]
      [div = class: "pad-wrap", onclick: runtime ${ (e) => { const key = e.target.closest("[data-key]"); if (key) press(key.dataset.key); } }$]
        [Keypad !]
      [end]
      # history: a side panel on the right, from under the top bar to the bottom
      [section = class: "panel", aria-label: "History", data-open: runtime ${ panelOpen() === "history" }$]
        [div = class: "panel-head"]
          [span]History[end]
          [button = class: "clear", type: "button", tabindex: "-1", disabled: runtime ${ now().lines.length === 0 }$, onclick: runtime ${ clearHistory }$]Clear[end]
        [end]
        [ol = class: "list", arcm-ref: "historyList", onclick: runtime ${ useLine }$][end]
        [p = class: "empty"]No calculations yet[end]
      [end:section]
      # keyboard: every shortcut, in the same kind of side panel
      [section = class: "panel keys", aria-label: "Keyboard shortcuts", data-open: runtime ${ panelOpen() === "keys" }$]
        [div = class: "panel-head"][span]Keyboard shortcuts[end][end]
        [div = class: "keys-list"]
          [for-each = ${ shortcuts }$, as: "g"]
            [h3]${ g.group }$[end]
            [dl]
              [for-each = ${ g.items }$, as: "it"]
                [dt][for-each = ${ it.keys }$, as: "k"][kbd]${ k }$[end][end][end]
                [dd]${ it.does }$[end]
              [end]
            [end:dl]
          [end]
        [end:div]
      [end:section]
      # settings: a page over the calculator, under the top bar
      [section = class: "page", aria-label: "Settings", arcm-ref: "settingsPanel", data-open: runtime ${ panelOpen() === "settings" }$]
        [div = class: "page-inner"]
          [div = class: "page-head"]
            [button = class: "back", type: "button", tabindex: "-1", aria-label: "Back", onclick: runtime ${ closePanel }$]
              [svg = viewBox: "0 0 24 24", aria-hidden: "true"][path = d: "m15 18-6-6 6-6" !][end]
            [end]
            [h1]Settings[end]
          [end]

          # decimals: choices, and two sample results that follow the choice
          [div = class: "card"]
            [h2]Decimals[end]
            [p = class: "desc"]How many digits results show after the point.[end]
            [div = class: "seg", onclick: runtime ${ pickDecimals }$]
              [for-each = ${ decimalChoices }$, as: "d"]
                [button = type: "button", tabindex: "-1", data-decimals: ${ String(d) }$]${ d === "auto" ? "Auto" : d }$[end]
              [end]
            [end]
            [div = class: "preview"]
              [div = class: "sample"][span]1 ÷ 3[end][b]= runtime ${ sample("1÷3") }$[end][end]
              [div = class: "sample"][span]10 ÷ 4[end][b]= runtime ${ sample("10÷4") }$[end][end]
            [end]
          [end:div]

          # indicator: each choice is drawn in its own style
          [div = class: "card"]
            [h2]Session indicator[end]
            [p = class: "desc"]How your sessions show under the display.[end]
            [div = class: "tiles", onclick: runtime ${ pickIndicator }$]
              [button = class: "tile", type: "button", tabindex: "-1", data-indicator: "dots"]
                [span = class: "mini"][i = class: "m-dot"][end][i = class: "m-dot on"][end][i = class: "m-dot"][end][end]
                [span = class: "tile-name"]Dots[end]
              [end]
              [button = class: "tile", type: "button", tabindex: "-1", data-indicator: "numbers"]
                [span = class: "mini"][i = class: "m-num"]1[end][i = class: "m-num on"]2[end][i = class: "m-num"]3[end][end]
                [span = class: "tile-name"]Numbers[end]
              [end]
            [end]
          [end:div]

          # clear all: what goes, then a button that asks twice
          [div = class: "card"]
            [h2]Clear all sessions[end]
            [p = class: "desc"]Removes every session and its history. Settings stay.[end]
            [div = class: "preview stats"]runtime ${ clearStats() }$[end]
            [button = class: "danger", type: "button", tabindex: "-1", data-armed: runtime ${ armed() }$, onclick: runtime ${ clearAll }$]runtime ${ armed() ? "Tap again to clear" : "Clear all" }$[end]
          [end:div]
        [end:div]
      [end:section]
      # about: a card over a dimmed background
      [div = class: "about-back", data-open: runtime ${ aboutOpen() }$, onclick: runtime ${ outsideAbout }$]
        [div = class: "about", role: "dialog", aria-label: "About Orbit"]
          [button = class: "about-close", type: "button", tabindex: "-1", aria-label: "Close", onclick: runtime ${ closeAbout }$]×[end]
          [span = class: "about-logo"]${ { raw: logo } }$[end]
          [h2]Orbit[end]
          [p = class: "about-tag"]A calculator with sessions you slide between[end]
          [dl]
            [dt]Creator[end][dd]Adam Elmi[end]
            [dt]Version[end][dd]${ version }$[end]
            [dt]State[end][dd][span = class: "state"]Stable[end][end]
            [dt]Purpose[end]
            [dd]
              Calculate without losing your previous calculations.
              [div = class: "more", data-open: runtime ${ purposeOpen() }$]
                [p][b]The problem:[end] Most calculators show one calculation at a time. When you start a new one, the old answer is gone, so you have to write it down or work it out again.[end]
                [p][b]How Orbit helps:[end] Orbit keeps several calculations open at once, each in its own session (like pages). For example, session 1 for your shopping total and session 2 for splitting a bill. Swipe, or press Ctrl+1 and Ctrl+2, to move between them. Every session keeps its numbers and history, even after you close Orbit.[end]
              [end:div]
              [button = class: "read-more", type: "button", tabindex: "-1", onclick: runtime ${ togglePurpose }$]runtime ${ purposeOpen() ? "Read less" : "Read more" }$[end]
            [end:dd]
            [dt]Repository[end][dd][a = href: ${ REPO }$, target: "_blank", rel: "noopener", onclick: runtime ${ openLink }$]${ REPO.replace("https://", "") }$[end][end]
          [end:dl]
        [end:div]
      [end:div]
    [end:main]
    # one session's display; the runtime code clones it per session
    [template = arcm-ref: "panel"]
      [section = class: "display"]
        [div = class: "line"][span = class: "line-text"]0[end][span = class: "cursor"][end][end]
        [div = class: "result"]= [span = class: "result-text"][end][end]
      [end:section]
    [end:template]
  [end:body]
[end:html]

[style]
  /* ###################
     Colors (Orbit.md §5): a deep ink background and graphite keys;
     gold, mint and lavender come from orbit-logo.svg
     ################### */
  :root {
    --bg: #0b0e14;
    --surface: #161b26;
    --surface-low: #10141d;
    --orbit: #b8bdf5;
    --result: #f2a93b;
    --result-light: #ffe08a;
    --active: #6ee7c8;
    color-scheme: dark;
  }
  * {
    box-sizing: border-box;
  }
  html,
  body {
    height: 100%;
  }
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    font-variant-numeric: tabular-nums;
    color: var(--orbit);
    /* faint glows: the planet's gold top right, the active session's mint bottom left */
    background:
      radial-gradient(circle at 100% 0%, rgb(242 169 59 / 0.09), transparent 45%),
      radial-gradient(circle at 0% 100%, rgb(110 231 200 / 0.06), transparent 50%),
      var(--bg);
    user-select: none;
  }

  /* ###################
     The app: sessions on top, dots, keypad below
     ################### */
  .app {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0 16px 16px;
    gap: 12px;
  }

  /* ###################
     The top bar: logo, empty space to drag, the toolbar, then minimize and close (Tauri only)
     ################### */
  :root {
    --bar: 36px;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 4px;
    height: var(--bar);
    margin: 0 -8px 0 0;
  }
  .logo {
    display: flex;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 6px;
    cursor: pointer;
    transition: transform 0.15s;
  }
  .logo:hover {
    transform: scale(1.08);
  }
  .logo:focus {
    outline: none;
  }
  /* only the empty drag space gives way when the window is narrow */
  .logo,
  .tools,
  .window,
  .tool,
  .win {
    flex-shrink: 0;
  }
  .logo svg {
    width: 20px;
    height: 20px;
    pointer-events: none;   /* the click goes to the button */
  }
  .grow {
    flex: 1;
    min-width: 0;
    align-self: stretch;
  }
  .tools,
  .window {
    display: flex;
    gap: 6px;
  }
  .window {
    display: none;
    padding-left: 6px;
    margin-left: 4px;
    border-left: 1px solid var(--surface);
  }
  :root[data-tauri] .window {
    display: flex;
  }
  .tool,
  .win {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    font: 18px/1 system-ui, sans-serif;
    color: var(--orbit);
    background: none;
    border: 0;
    border-radius: 8px;
    cursor: pointer;
  }
  .tool svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tool:hover,
  .win:hover {
    background: var(--surface);
  }
  .tool:focus,
  .win:focus {
    outline: none;   /* clicked, not tabbed to: tabindex -1 */
  }
  .tool[data-active] {
    color: var(--active);
    background: var(--surface);
  }

  /* ###################
     History panel: slides in from the right, full height under the top bar
     ################### */
  .panel {
    position: fixed;
    top: var(--bar);
    right: 0;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: min(300px, 85vw);
    padding: 10px 16px 0;
    background: rgb(11 14 20 / 0.96);
    backdrop-filter: blur(8px);
    border-left: 1px solid var(--surface);
    border-top: 1px solid var(--surface);
    border-radius: 16px 0 0 0;
    box-shadow: -12px 0 32px rgb(0 0 0 / 0.35);
    transform: translateX(105%);
    transition: transform 0.2s ease-out;
  }
  .panel[data-open] {
    transform: none;
  }
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 6px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--orbit) 70%, transparent);
  }
  .clear {
    padding: 4px 10px;
    font: 500 12px/1 system-ui, sans-serif;
    color: var(--orbit);
    background: var(--surface);
    border: 0;
    border-radius: 8px;
    cursor: pointer;
  }
  .clear:hover {
    color: var(--bg);
    background: var(--result);
  }
  .clear:disabled {
    opacity: 0.4;
    pointer-events: none;
  }
  .list {
    flex: 1;
    min-height: 0;
    margin: 0 -8px;
    padding: 0 0 8px;
    overflow-y: auto;
    list-style: none;
    scrollbar-width: thin;
    scrollbar-color: var(--surface) transparent;
  }
  .list button {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 8px;
    width: 100%;
    padding: 6px 8px;
    font: 15px/1.3 system-ui, sans-serif;
    font-variant-numeric: tabular-nums;
    text-align: right;
    background: none;
    border: 0;
    border-radius: 8px;
    cursor: pointer;
  }
  .list button:hover {
    background: var(--surface);
  }
  .h-line {
    color: color-mix(in srgb, var(--orbit) 65%, transparent);
  }
  .h-result {
    color: var(--result);
  }
  .empty {
    display: none;
    margin: 0;
    padding: 12px 0;
    text-align: center;
    font-size: 14px;
    color: color-mix(in srgb, var(--orbit) 50%, transparent);
  }
  .list:empty + .empty {
    display: block;
  }

  /* ###################
     Keyboard panel: groups of shortcuts, keys drawn as keycaps
     ################### */
  .keys-list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding-bottom: 12px;
    scrollbar-width: thin;
    scrollbar-color: var(--surface) transparent;
  }
  .keys-list h3 {
    margin: 10px 0 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--active);
  }
  .keys-list dl {
    display: grid;
    grid-template-columns: 104px 1fr;   /* the same key column in every group */
    align-items: center;
    gap: 7px 12px;
    margin: 0;
  }
  .keys-list dt {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
  }
  .keys-list dd {
    margin: 0;
    font-size: 13px;
    line-height: 1.35;
    color: color-mix(in srgb, var(--orbit) 80%, transparent);
  }
  kbd {
    min-width: 22px;
    padding: 2px 6px;
    font: 500 11px/16px system-ui, sans-serif;
    text-align: center;
    color: #fff;
    background: var(--surface);
    border: 1px solid color-mix(in srgb, var(--orbit) 20%, transparent);
    border-bottom-width: 2px;
    border-radius: 5px;
  }

  /* ###################
     Settings page: slides in over the calculator, cards with a preview each
     ################### */
  .page {
    position: fixed;
    top: var(--bar);
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    overflow-y: auto;
    background: var(--bg);
    border-top: 1px solid var(--surface);
    scrollbar-width: thin;
    scrollbar-color: var(--surface) transparent;
    transform: translateX(100%);
    transition: transform 0.22s ease-out;
  }
  .page[data-open] {
    transform: none;
  }
  .page-inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 12px 16px 24px;
  }
  .page-head {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
  }
  .page-head h1 {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    color: #fff;
  }
  .back {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-left: -6px;
    padding: 0;
    color: var(--orbit);
    background: none;
    border: 0;
    border-radius: 10px;
    cursor: pointer;
  }
  .back:hover {
    background: var(--surface);
  }
  .back svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    background: var(--surface-low);
    border: 1px solid var(--surface);
    border-radius: 16px;
  }
  .card h2 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: #fff;
  }
  .desc {
    margin: -6px 0 2px;
    font-size: 13px;
    line-height: 1.4;
    color: color-mix(in srgb, var(--orbit) 65%, transparent);
  }

  /* one row of choices, like a segmented switch */
  .seg {
    display: flex;
    padding: 3px;
    background: var(--bg);
    border-radius: 10px;
  }
  .seg button {
    flex: 1;
    padding: 7px 0;
    font: 500 13px/1 system-ui, sans-serif;
    color: color-mix(in srgb, var(--orbit) 80%, transparent);
    background: none;
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .seg button:hover {
    color: #fff;
  }
  .seg button[data-active] {
    color: var(--bg);
    background: var(--active);
  }

  /* previews: what the setting does, live */
  .preview {
    padding: 10px 12px;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    background: var(--bg);
    border-radius: 10px;
  }
  .sample {
    display: flex;
    justify-content: space-between;
    padding: 2px 0;
  }
  .sample span {
    color: color-mix(in srgb, var(--orbit) 65%, transparent);
  }
  .sample b {
    font-weight: 500;
    color: var(--result);
  }
  .stats {
    color: var(--orbit);
  }

  /* indicator tiles: each drawn in its own style */
  .tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 14px 8px 10px;
    color: var(--orbit);
    background: var(--bg);
    border: 1.5px solid transparent;
    border-radius: 12px;
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .tile:hover {
    border-color: var(--surface);
  }
  .tile[data-active] {
    border-color: var(--active);
  }
  .mini {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 20px;
  }
  .m-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--orbit) 55%, transparent);
  }
  .m-dot.on {
    width: 18px;
    border-radius: 4px;
    background: var(--active);
  }
  .m-num {
    min-width: 18px;
    font: 600 11px/18px system-ui, sans-serif;
    font-style: normal;
    text-align: center;
    color: color-mix(in srgb, var(--orbit) 75%, transparent);
    border-radius: 5px;
  }
  .m-num.on {
    min-width: 28px;
    color: var(--bg);
    background: var(--active);
  }
  .tile-name {
    font-size: 13px;
  }

  .danger {
    align-self: flex-start;
    padding: 9px 16px;
    font: 500 13px/1 system-ui, sans-serif;
    color: #ff8a8a;
    background: rgb(255 90 90 / 0.08);
    border: 1px solid rgb(255 90 90 / 0.25);
    border-radius: 10px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .danger:hover,
  .danger[data-armed] {
    color: var(--bg);
    background: #ff8a8a;
  }
  .close:hover {
    color: var(--bg);
    background: var(--result);
  }
  .viewport {
    flex: 1;
    min-height: 0;
    margin: 0 -16px;
    overflow: hidden;
  }
  .track {
    display: flex;
    height: 100%;
  }
  .track[data-ready] {
    transition: transform 0.2s ease-out;
  }

  /* ###################
     One session's display
     ################### */
  .display {
    flex: 0 0 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 16px;
    text-align: right;
  }
  .line {
    margin-top: 8px;
    font-size: 36px;
    line-height: 1.2;
    color: #fff;
    overflow-wrap: anywhere;
  }
  .display[data-empty] .line {
    color: color-mix(in srgb, var(--orbit) 50%, transparent);
  }
  .cursor {
    display: none;
    width: 2px;
    height: 0.9em;
    margin-left: 2px;
    vertical-align: -0.1em;
    background: var(--active);
    animation: blink 1s steps(1) infinite;
  }
  .display[data-current] .cursor {
    display: inline-block;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .result {
    min-height: 1.4em;
    font-size: 22px;
    color: var(--result);
    visibility: hidden;
  }
  .display[data-show] .result {
    visibility: visible;
  }

  /* ###################
     Dots: inactive in lavender (like the logo's orbit), the current one in mint
     ################### */
  .dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    min-height: 10px;
  }
  .dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--orbit) 55%, transparent);
    cursor: pointer;
    transition: width 0.2s, background 0.2s;
  }
  .dot[data-current] {
    width: 20px;
    border-radius: 4px;
    background: var(--active);
  }
  /* numbers: like a status bar's workspaces */
  .num {
    min-width: 24px;
    height: 20px;
    padding: 0 6px;
    font: 600 12px/20px system-ui, sans-serif;
    color: color-mix(in srgb, var(--orbit) 75%, transparent);
    background: none;
    border: 0;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .num:hover {
    color: var(--orbit);
    background: var(--surface);
  }
  .num[data-current] {
    min-width: 36px;
    color: var(--bg);
    background: var(--active);
  }

  /* ###################
     Short windows (a browser tab, a small screen): smaller keys and text,
     so the line and its result always show
     ################### */
  @media (max-height: 520px) {
    .app {
      padding-bottom: 10px;
      gap: 6px;
    }
    :root {
      --bar: 28px;
    }
    .line {
      font-size: 28px;
    }
    .result {
      font-size: 18px;
    }
  }

  /* ###################
     About card
     ################### */
  .about-back {
    position: fixed;
    inset: 0;
    z-index: 3;
    display: grid;
    place-items: center;
    padding: 16px;
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s;
  }
  .about-back[data-open] {
    opacity: 1;
    pointer-events: auto;
  }
  .about {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(340px, 100%);
    max-height: 100%;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--surface) transparent;
    padding: 24px 20px 18px;
    background: var(--surface-low);
    border: 1px solid var(--surface);
    border-radius: 18px;
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.5);
    transform: scale(0.96);
    transition: transform 0.18s;
  }
  .about-back[data-open] .about {
    transform: none;
  }
  .about-close {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 28px;
    height: 28px;
    padding: 0;
    font: 18px/1 system-ui, sans-serif;
    color: var(--orbit);
    background: none;
    border: 0;
    border-radius: 8px;
    cursor: pointer;
  }
  .about-close:hover {
    background: var(--surface);
  }
  .about-logo svg {
    display: block;
    width: 64px;
    height: 64px;
  }
  .about h2 {
    margin: 10px 0 2px;
    font-size: 20px;
    color: #fff;
  }
  .about-tag {
    margin: 0 0 16px;
    font-size: 13px;
    text-align: center;
    color: color-mix(in srgb, var(--orbit) 65%, transparent);
  }
  .about dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 14px;
    width: 100%;
    margin: 0;
    padding-top: 14px;
    font-size: 13px;
    border-top: 1px solid var(--surface);
  }
  .about dt {
    color: color-mix(in srgb, var(--orbit) 60%, transparent);
  }
  .about dd {
    margin: 0;
    line-height: 1.4;
    color: #fff;
  }
  .state {
    padding: 2px 8px;
    font-size: 12px;
    color: var(--bg);
    background: var(--active);
    border-radius: 6px;
  }
  .more {
    display: none;
    margin: 6px 0 0;
    color: color-mix(in srgb, var(--orbit) 85%, transparent);
  }
  .more[data-open] {
    display: block;
  }
  .more p {
    margin: 0 0 6px;
  }
  .more b {
    font-weight: 600;
    color: #fff;
  }
  .read-more {
    display: block;
    margin-top: 4px;
    padding: 0;
    font: 500 12px/1.4 system-ui, sans-serif;
    color: var(--active);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .read-more:hover {
    text-decoration: underline;
  }
  .about a {
    color: var(--result);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .about a:hover {
    text-decoration: underline;
  }
[end]
