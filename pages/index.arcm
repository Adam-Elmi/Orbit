# ###################
# Orbit: the one page
# Sessions you slide between, each with its line and live result; panels for shortcuts and
# history, a settings page, an about card and a notice. State lives in src/lib/state.js
# ###################
[import = TopBar: "@/components/TopBar.arcm" !]
[import = Sessions: "@/components/Sessions.arcm" !]
[import = Indicator: "@/components/Indicator.arcm" !]
[import = Keypad: "@/components/Keypad.arcm" !]
[import = KeysPanel: "@/components/KeysPanel.arcm" !]
[import = HistoryPanel: "@/components/HistoryPanel.arcm" !]
[import = SettingsPage: "@/components/SettingsPage.arcm" !]
[import = AboutCard: "@/components/AboutCard.arcm" !]
[import = Toast: "@/components/Toast.arcm" !]

runtime ${
  import "../src/lib/keyboard.js";
}$

[doctype!]
[html = lang: "en"]
  [head]
    [meta = charset: "utf-8" !]
    [meta = name: "viewport", content: "width=device-width, initial-scale=1" !]
    [title]Orbit[end]
  [end:head]
  [body]
    [main = class: "app"]
      [TopBar !]
      [Sessions !]
      [Indicator !]
      [Keypad !]
      [KeysPanel !]
      [HistoryPanel !]
      [SettingsPage !]
      [AboutCard !]
      [Toast !]
    [end:main]
  [end:body]
[end:html]

[style]
  /* ###################
     Colors (Orbit.md §5): dark by default; data-theme="light" swaps them (Settings → Theme).
     Gold, mint and lavender come from orbit-logo.svg
     ################### */
  :root {
    --bg: #0b0e14;
    --surface: #161b26;
    --surface-low: #10141d;
    --orbit: #b8bdf5;
    --result: #f2a93b;
    --result-light: #ffe08a;
    --active: #6ee7c8;
    --gold: #f2a93b;                   /* the = key, the same in both themes */
    --ink: #fff;                       /* strong text */
    --on-accent: #0b0e14;              /* text on mint and gold */
    --glass: rgb(11 14 20 / 0.96);     /* side panels */
    --danger: #ff8a8a;
    --key-shadow: inset 0 1px rgb(255 255 255 / 0.04);
    --pill-bg: var(--active);          /* chosen chips with text: decimals, session number, badge */
    --pill-ink: var(--on-accent);
    color-scheme: dark;
  }
  :root[data-theme="light"] {
    --bg: #f4f5fa;
    --surface: #ffffff;
    --surface-low: #eceef5;
    --orbit: #4a4f8c;                  /* the logo's navy, softened */
    --result: #c97a10;                 /* deeper gold, readable on white */
    --result-light: #ffd27a;
    --active: #0f9f80;                 /* deeper mint */
    --ink: #14163a;
    --glass: rgb(255 255 255 / 0.95);
    --danger: #d64545;
    --key-shadow: 0 1px 2px rgb(20 22 58 / 0.08), inset 0 0 0 1px rgb(20 22 58 / 0.06);
    --pill-bg: rgb(15 159 128 / 0.14);   /* a soft mint tint with dark-green text */
    --pill-ink: #0b6e59;
    color-scheme: light;
  }
  * {
    box-sizing: border-box;
  }
  html,
  body {
    height: 100%;
  }
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    font-variant-numeric: tabular-nums;
    color: var(--orbit);
    /* faint glows: the planet's gold top right, the active session's mint bottom left */
    background:
      radial-gradient(circle at 100% 0%, rgb(242 169 59 / 0.09), transparent 45%),
      radial-gradient(circle at 0% 100%, rgb(110 231 200 / 0.06), transparent 50%),
      var(--bg);
    -webkit-user-select: none;   /* WebKitGTK (Tauri on Linux) needs the prefix */
    user-select: none;
  }

  /* ###################
     The app: sessions on top, dots, keypad below
     ################### */
  .app {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0 16px 16px;
    gap: 12px;
  }
  :root {
    --bar: 36px;   /* the top bar's height; panels and settings start under it */
  }

  /* short windows (a browser tab, a small screen): a thinner bar and less spacing */
  @media (max-height: 520px) {
    .app {
      padding-bottom: 10px;
      gap: 6px;
    }
    :root {
      --bar: 28px;
    }
  }
[end]
