# ###################
# Orbit: the one page
# Sessions you slide between, each with its line and live result; panels for shortcuts and
# history, a settings page and an about card. State lives in src/lib/state.js
# ###################
[import = TopBar: "@/components/TopBar.arcm" !]
[import = Sessions: "@/components/Sessions.arcm" !]
[import = Indicator: "@/components/Indicator.arcm" !]
[import = Keypad: "@/components/Keypad.arcm" !]
[import = KeysPanel: "@/components/KeysPanel.arcm" !]
[import = HistoryPanel: "@/components/HistoryPanel.arcm" !]
[import = SettingsPage: "@/components/SettingsPage.arcm" !]
[import = AboutCard: "@/components/AboutCard.arcm" !]

runtime ${
  import "../src/lib/keyboard.js";
}$

[doctype!]
[html = lang: "en"]
  [head]
    [meta = charset: "utf-8" !]
    [meta = name: "viewport", content: "width=device-width, initial-scale=1" !]
    [title]Orbit[end]
  [end:head]
  [body]
    [main = class: "app"]
      [TopBar !]
      [Sessions !]
      [Indicator !]
      [Keypad !]
      [KeysPanel !]
      [HistoryPanel !]
      [SettingsPage !]
      [AboutCard !]
    [end:main]
  [end:body]
[end:html]

[style]
  /* ###################
     Colors (Orbit.md §5): a deep ink background and graphite keys;
     gold, mint and lavender come from orbit-logo.svg
     ################### */
  :root {
    --bg: #0b0e14;
    --surface: #161b26;
    --surface-low: #10141d;
    --orbit: #b8bdf5;
    --result: #f2a93b;
    --result-light: #ffe08a;
    --active: #6ee7c8;
    color-scheme: dark;
  }
  * {
    box-sizing: border-box;
  }
  html,
  body {
    height: 100%;
  }
  body {
    margin: 0;
    font-family: system-ui, sans-serif;
    font-variant-numeric: tabular-nums;
    color: var(--orbit);
    /* faint glows: the planet's gold top right, the active session's mint bottom left */
    background:
      radial-gradient(circle at 100% 0%, rgb(242 169 59 / 0.09), transparent 45%),
      radial-gradient(circle at 0% 100%, rgb(110 231 200 / 0.06), transparent 50%),
      var(--bg);
    -webkit-user-select: none;   /* WebKitGTK (Tauri on Linux) needs the prefix */
    user-select: none;
  }

  /* ###################
     The app: sessions on top, dots, keypad below
     ################### */
  .app {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0 16px 16px;
    gap: 12px;
  }
  :root {
    --bar: 36px;   /* the top bar's height; panels and settings start under it */
  }

  /* short windows (a browser tab, a small screen): a thinner bar and less spacing */
  @media (max-height: 520px) {
    .app {
      padding-bottom: 10px;
      gap: 6px;
    }
    :root {
      --bar: 28px;
    }
  }
[end]
