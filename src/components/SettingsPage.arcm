# ###################
# SettingsPage: covers the calculator under the top bar, laid out like Ubuntu's Settings:
# a centered title, groups with a small heading, and rounded lists of rows
# (title and subtitle on the left, the control on the right)
# ###################
[import = Icon: "@/components/Icon.arcm" !]

${
  // the same choices as src/lib/settings.js
  const decimalChoices = ["auto", 2, 4, 6, 10];
}$

runtime ${
  import { signal, effect } from "arcmoon/reactive";
  import { settings, setSetting, sessions, work, panelOpen, closePanel, clearAll } from "../lib/state.js";

  // ###################
  // Choices carry their value in data- (build-time loop names don't reach the browser)
  // ###################
  const page = ArcMoon.ref(ArcMoon.defineRef("settingsPage"));
  const decimalsMenu = ArcMoon.ref(ArcMoon.defineRef("decimals"));
  effect(() => {
    const { decimals, indicator, theme } = settings();
    decimalsMenu.value = String(decimals);
    for (const b of page.querySelectorAll("[data-indicator]")) b.toggleAttribute("data-active", b.dataset.indicator === indicator);
    for (const b of page.querySelectorAll("[data-theme-choice]")) b.toggleAttribute("data-active", b.dataset.themeChoice === theme);
  });
  const pickDecimals = (e) => setSetting({ decimals: e.target.value === "auto" ? "auto" : Number(e.target.value) });
  const pickTheme = (e) => {
    const value = e.target.closest("[data-theme-choice]")?.dataset.themeChoice;
    if (value) setSetting({ theme: value });
  };
  const pickIndicator = (e) => {
    const value = e.target.closest("[data-indicator]")?.dataset.indicator;
    if (value) setSetting({ indicator: value });
  };
  const toggleSplash = () => setSetting({ splash: !settings().splash });

  // ###################
  // Subtitles: what Clear all removes
  // ###################
  const plural = (n, word) => `${n} ${word}${n === 1 ? "" : "s"}`;
  const clearStats = () => `${plural(sessions().length, "session")} · ${plural(sessions().reduce((n, s) => n + s.lines.length, 0), "calculation")}`;

  // Clear all: the first click asks, a second one within 3 s clears
  const armed = signal(false);
  let disarm = null;
  const askThenClear = () => {
    clearTimeout(disarm);
    if (!armed()) {
      armed(true);
      disarm = setTimeout(() => armed(false), 3000);
      return;
    }
    armed(false);
    clearAll();
  };
}$

[section = class: "page", aria-label: "Settings", arcm-ref: "settingsPage", data-open: runtime ${ panelOpen() === "settings" }$]
  [div = class: "page-head"]
    [button = class: "back", type: "button", tabindex: "-1", aria-label: "Back", onclick: runtime ${ closePanel }$][Icon = name: "back", size: 20 !][end]
    [h1]Settings[end]
  [end]

  [div = class: "page-inner"]
    # appearance: each theme drawn as a tiny Orbit in its colors
    [div = class: "group"]
      [h2]Appearance[end]
      [div = class: "list"]
        [div = class: "row block"]
          [div = class: "text"][span = class: "title"]Style[end][span = class: "sub"]Light or dark, or follow your system[end][end]
          [div = class: "tiles", onclick: runtime ${ pickTheme }$]
            [button = class: "tile", type: "button", tabindex: "-1", data-theme-choice: "system"]
              [span = class: "screen system"][i = class: "s-line"][end][i = class: "s-key"][end][end]
              [span = class: "tile-name"]System[end]
            [end]
            [button = class: "tile", type: "button", tabindex: "-1", data-theme-choice: "light"]
              [span = class: "screen light"][i = class: "s-line"][end][i = class: "s-key"][end][end]
              [span = class: "tile-name"]Light[end]
            [end]
            [button = class: "tile", type: "button", tabindex: "-1", data-theme-choice: "dark"]
              [span = class: "screen dark"][i = class: "s-line"][end][i = class: "s-key"][end][end]
              [span = class: "tile-name"]Dark[end]
            [end]
          [end]
        [end:div]
        # splash: a switch, like Ubuntu's
        [div = class: "row"]
          [div = class: "text"][span = class: "title"]Splash on start[end][span = class: "sub"]The logo for a moment when Orbit opens[end][end]
          [button = class: "switch", type: "button", role: "switch", tabindex: "-1", aria-label: "Splash on start", aria-checked: runtime ${ settings().splash ? "true" : "false" }$, data-on: runtime ${ settings().splash }$, onclick: runtime ${ toggleSplash }$][span = class: "knob"][end][end]
        [end:div]
      [end:div]
    [end:div]

    # calculator: decimals (a menu; the subtitle shows its effect) and the session indicator
    [div = class: "group"]
      [h2]Calculator[end]
      [div = class: "list"]
        [label = class: "row"]
          [div = class: "text"][span = class: "title"]Decimals[end][span = class: "sub"]1 ÷ 3 = runtime ${ work("1÷3") ?? "" }$[end][end]
          [span = class: "menu"]
            [select = arcm-ref: "decimals", tabindex: "-1", aria-label: "Decimals", onchange: runtime ${ pickDecimals }$]
              [for-each = ${ decimalChoices }$, as: "d"]
                [option = value: ${ String(d) }$]${ d === "auto" ? "Auto" : `${d} digits` }$[end]
              [end]
            [end:select]
            [span = class: "chevron"][Icon = name: "down", size: 16 !][end]
          [end:span]
        [end:label]
        # each choice drawn in its own style
        [div = class: "row block"]
          [div = class: "text"][span = class: "title"]Session indicator[end][span = class: "sub"]How your sessions show under the display[end][end]
          [div = class: "tiles two", onclick: runtime ${ pickIndicator }$]
            [button = class: "tile", type: "button", tabindex: "-1", data-indicator: "dots"]
              [span = class: "screen mini"][i = class: "m-dot"][end][i = class: "m-dot on"][end][i = class: "m-dot"][end][end]
              [span = class: "tile-name"]Dots[end]
            [end]
            [button = class: "tile", type: "button", tabindex: "-1", data-indicator: "numbers"]
              [span = class: "screen mini"][i = class: "m-num"]1[end][i = class: "m-num on"]2[end][i = class: "m-num"]3[end][end]
              [span = class: "tile-name"]Numbers[end]
            [end]
          [end]
        [end:div]
      [end:div]
    [end:div]

    # data: what Clear all removes, and a button that asks twice
    [div = class: "group"]
      [h2]Data[end]
      [div = class: "list"]
        [div = class: "row"]
          [div = class: "text"][span = class: "title"]Clear all sessions[end][span = class: "sub"]runtime ${ clearStats() }$[end][end]
          [button = class: "danger", type: "button", tabindex: "-1", data-armed: runtime ${ armed() }$, onclick: runtime ${ askThenClear }$]runtime ${ armed() ? "Tap again" : "Clear" }$[end]
        [end:div]
      [end:div]
      [p = class: "note"]Removes every session and its history. Settings stay.[end]
    [end:div]
  [end:div]
[end:section]

[style]
  /* ###################
     Settings page: slides in over the calculator
     ################### */
  .page {
    position: fixed;
    top: var(--bar);
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border-top: 1px solid var(--surface);
    transform: translateX(100%);
    transition: transform 0.22s ease-out;
  }
  .page[data-open] {
    transform: none;
  }

  /* header: back on the left, the title centered over the page */
  .page-head {
    position: relative;
    display: flex;
    align-items: center;
    flex: none;
    height: 44px;
    padding: 0 10px;
  }
  .page-head h1 {
    position: absolute;
    left: 50%;
    margin: 0;
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    transform: translateX(-50%);
  }
  .back {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    color: var(--orbit);
    background: none;
    border: 0;
    border-radius: 8px;
    cursor: pointer;
  }
  .back:hover {
    background: var(--surface);
  }
  .page-inner {
    display: flex;
    flex-direction: column;
    gap: 22px;
    flex: 1;
    overflow-y: auto;
    padding: 6px 16px 24px;
    scrollbar-width: thin;
    scrollbar-color: var(--surface) transparent;
  }

  /* ###################
     Groups: a small heading over a rounded list; rows split by thin lines
     ################### */
  .group h2 {
    margin: 0 0 8px 2px;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
  }
  .list {
    overflow: hidden;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
    padding: 10px 14px;
  }
  .row + .row {
    border-top: 1px solid var(--line);
  }
  .row.block {
    flex-direction: column;
    align-items: stretch;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .title {
    font-size: 14px;
    color: var(--ink);
  }
  .sub,
  .note {
    font-size: 12px;
    line-height: 1.4;
    color: color-mix(in srgb, var(--orbit) 65%, transparent);
  }
  .note {
    margin: 8px 2px 0;
  }

  /* menu: the select's own look is hidden; a chevron sits on its right */
  .menu {
    position: relative;
    display: flex;
    align-items: center;
    flex: none;
  }
  .menu select {
    padding: 7px 30px 7px 12px;
    font: 500 13px/1.2 system-ui, sans-serif;
    color: var(--ink);
    background: var(--control);
    border: 0;
    border-radius: 8px;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
  }
  .menu select:focus {
    outline: none;
  }
  .menu option {
    color: var(--ink);
    background: var(--card);
  }
  .chevron {
    position: absolute;
    right: 9px;
    display: flex;
    color: var(--orbit);
    pointer-events: none;
  }

  /* indicator tiles: two across, each a tiny indicator in the app's colors */
  .tiles.two {
    grid-template-columns: 1fr 1fr;
  }
  .screen.mini {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 44px;
    background: var(--control);
    box-shadow: none;
  }
  .m-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--orbit) 55%, transparent);
  }
  .m-dot.on {
    width: 18px;
    border-radius: 4px;
    background: var(--active);
  }
  .m-num {
    min-width: 18px;
    font: 600 11px/18px system-ui, sans-serif;
    font-style: normal;
    text-align: center;
    color: color-mix(in srgb, var(--orbit) 75%, transparent);
    border-radius: 5px;
  }
  .m-num.on {
    min-width: 28px;
    color: var(--pill-ink);
    background: var(--pill-bg);
  }

  /* theme tiles: three across, each a tiny screen in that theme's own colors (not the tokens) */
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 6px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 0;
    color: var(--orbit);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .screen {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-end;
    gap: 5px;
    width: 100%;
    height: 52px;
    padding: 8px;
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px rgb(127 127 127 / 0.25);
    outline: 2px solid transparent;
    outline-offset: 2px;
    transition: outline-color 0.15s;
  }
  .tile:hover .screen {
    outline-color: var(--line);
  }
  .tile[data-active] .screen {
    outline-color: var(--active);
  }
  .screen.dark {
    background: #0b0e14;
  }
  .screen.light {
    background: #f4f5fa;
  }
  .screen.system {
    background: linear-gradient(135deg, #0b0e14 50%, #f4f5fa 50%);
  }
  .s-line {
    width: 60%;
    height: 5px;
    border-radius: 3px;
    background: #b8bdf5;
  }
  .light .s-line,
  .system .s-line {
    background: #4a4f8c;
  }
  .s-key {
    width: 100%;
    height: 8px;
    border-radius: 3px;
    background: linear-gradient(135deg, #ffe08a, #f2a93b);
  }
  .tile-name {
    font-size: 12px;
  }
  .tile[data-active] .tile-name {
    color: var(--ink);
  }

  /* switch: a pill with a knob; mint when on */
  .switch {
    position: relative;
    flex: none;
    width: 44px;
    height: 24px;
    padding: 0;
    background: var(--control);
    border: 0;
    border-radius: 12px;
    cursor: pointer;
    transition: background 0.15s;
  }
  .switch[data-on] {
    background: var(--active);
  }
  .knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
    transition: transform 0.15s;
  }
  .switch[data-on] .knob {
    transform: translateX(20px);
  }

  .danger {
    flex: none;
    padding: 7px 14px;
    font: 500 13px/1.2 system-ui, sans-serif;
    color: var(--danger);
    background: color-mix(in srgb, var(--danger) 10%, transparent);
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .danger:hover,
  .danger[data-armed] {
    color: var(--on-accent);
    background: var(--danger);
  }
[end]
