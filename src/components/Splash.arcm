# ###################
# Splash: the logo and name for a moment when Orbit opens, then a fade to the calculator
# (already drawn underneath). A gold ring sweeps around the logo once.
# Any key or click ends it early; that key isn't typed. Off in Settings: removed at once
# ###################
${
  import { readFileSync } from "node:fs";
  // the logo, without the file's metadata block
  const logo = readFileSync(new URL("../../orbit-logo.svg", import.meta.url), "utf8").replace(/<metadata>[\s\S]*?<\/metadata>/, "");
  const ring = '<svg class="ring" viewBox="0 0 100 100" aria-hidden="true"><defs><linearGradient id="splash-gold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffe08a"/><stop offset="1" stop-color="#f2a93b"/></linearGradient></defs><circle cx="50" cy="50" r="46" pathLength="100"/></svg>';
}$

runtime ${
  import { settings } from "../lib/state.js";

  const splash = ArcMoon.ref(ArcMoon.defineRef("splash"));
  const SHOW = 800;   // ms on screen
  const FADE = 250;   // ms to fade out

  let done = false;
  const end = () => {
    if (done) return;
    done = true;
    removeEventListener("keydown", skip, true);
    splash.setAttribute("data-out", "");
    setTimeout(() => splash.remove(), FADE);
  };
  // first in line for keys (capture), so the key ends the splash and goes no further
  const skip = (e) => {
    e.preventDefault();
    e.stopImmediatePropagation();
    end();
  };

  if (!settings().splash) splash.remove();
  else {
    addEventListener("keydown", skip, true);
    splash.addEventListener("pointerdown", (e) => {
      e.preventDefault();
      end();
    });
    setTimeout(end, SHOW);
  }
}$

[div = class: "splash", arcm-ref: "splash", aria-hidden: "true"]
  [div = class: "mark"]
    ${ { raw: ring } }$
    [span = class: "logo"]${ { raw: logo } }$[end]
  [end]
  [span = class: "name"]Orbit[end]
[end:div]

[style]
  /* ###################
     Over everything, in the theme's background; fades out when done
     ################### */
  .splash {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    background:
      radial-gradient(circle at 100% 0%, rgb(242 169 59 / 0.09), transparent 45%),
      radial-gradient(circle at 0% 100%, rgb(110 231 200 / 0.06), transparent 50%),
      var(--bg);
    transition: opacity 0.25s ease-out;
  }
  .splash[data-out] {
    opacity: 0;
    pointer-events: none;
  }

  /* the logo inside the ring; the ring's stroke draws itself once around */
  .mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 112px;
    height: 112px;
    animation: rise 0.45s ease-out both;
  }
  .logo {
    display: flex;
  }
  /* raw SVG doesn't get the component's scope */
  .logo :global(svg) {
    width: 76px;
    height: 76px;
    border-radius: 18px;
  }
  .mark :global(.ring) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
  }
  .mark :global(.ring circle) {
    fill: none;
    stroke: url(#splash-gold);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: sweep 0.7s 0.1s ease-in-out forwards;
  }
  .name {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink);
    animation: rise 0.45s 0.1s ease-out both;
  }
  @keyframes sweep {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mark,
    .name,
    .mark :global(.ring circle) {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
[end]
