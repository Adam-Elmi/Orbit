# ###################
# Sessions: one display per session, side by side; the track slides so the current one shows
# Displays are cloned from the [template] (no live [for-each] yet). Two-finger swipe moves too
# The copy button beside the result copies it; a check shows after any copy (button or Ctrl+C)
# The line shrinks to fit (36px down to 20px), then wraps; a click in it places the caret
# ###################
[import = Icon: "@/components/Icon.arcm" !]

runtime ${
  import { effect } from "arcmoon/reactive";
  import { sessions, current, go, work, isPlain, showAt, shownToCaret, caretOf, moveTo, copyValue, copy, copied } from "../lib/state.js";

  const track = ArcMoon.ref(ArcMoon.defineRef("track"));
  const display = ArcMoon.ref(ArcMoon.defineRef("display"));

  // ###################
  // Fill one display from its session
  // ###################
  const fill = (el, session, isCurrent) => {
    const value = work(session.input);
    const [left, right] = session.input ? showAt(session.input, caretOf(session)) : ["0", ""];
    el.querySelector(".left").textContent = left;
    el.querySelector(".right").textContent = right;
    el.querySelector(".result-text").textContent = value ?? "";
    el.toggleAttribute("data-empty", session.input === "");
    // the result shows only when it says something new: not for 453, not after Enter
    el.toggleAttribute("data-show", value !== null && !isPlain(session.input));
    el.toggleAttribute("data-current", isCurrent);
    el.toggleAttribute("data-copy", copyValue(session) !== null);
    fit(el);
  };

  // ###################
  // Fit: the largest size (from the CSS, 2px steps, at least 20px) that keeps the line on one row;
  // longer lines wrap at 20px and scroll, so the caret stays in view. The result shrinks with it
  // ###################
  const MIN = 20;
  const fit = (el) => {
    const line = el.querySelector(".line");
    const result = el.querySelector(".result");
    line.style.fontSize = result.style.fontSize = "";
    const base = parseFloat(getComputedStyle(line).fontSize);
    const baseResult = parseFloat(getComputedStyle(result).fontSize);
    const text = el.querySelector(".text");
    let size = base;
    while (size > MIN && text.offsetHeight > size * 1.2 * 1.5) {
      size -= 2;
      line.style.fontSize = `${size}px`;
    }
    if (size < base) result.style.fontSize = `${Math.max(18, Math.round((baseResult * size) / base))}px`;
    const box = line.getBoundingClientRect();
    const caret = el.querySelector(".cursor").getBoundingClientRect();
    if (caret.top < box.top) line.scrollTop -= box.top - caret.top;
    else if (caret.bottom > box.bottom) line.scrollTop += caret.bottom - box.bottom;
  };
  addEventListener("resize", () => {
    for (const el of track.children) fit(el);
  });

  effect(() => {
    const list = sessions();
    const at = current();
    while (track.childElementCount < list.length) track.append(display.content.firstElementChild.cloneNode(true));
    while (track.childElementCount > list.length) track.lastElementChild.remove();
    list.forEach((session, i) => fill(track.children[i], session, i === at));
    track.style.transform = `translateX(${-at * 100}%)`;
  });
  // slide only after the first draw, so launching on session 3 doesn't slide there from session 1
  requestAnimationFrame(() => requestAnimationFrame(() => track.setAttribute("data-ready", "")));

  // ###################
  // Copy: the button copies; every copy button shows a check while copied() is set
  // ###################
  track.addEventListener("click", (e) => {
    if (e.target.closest(".copy")) return copy();
    const el = e.target.closest(".display");
    if (el?.hasAttribute("data-current") && !el.hasAttribute("data-empty")) placeCaret(el, e);
  });

  // ###################
  // Click → caret: find the clicked place in the text (before or after the caret's span),
  // count the characters before it, and drop the spaces show() added
  // ###################
  const placeCaret = (el, e) => {
    const left = el.querySelector(".left");
    const right = el.querySelector(".right");
    const at = document.caretPositionFromPoint?.(e.clientX, e.clientY);
    const range = at ? null : document.caretRangeFromPoint?.(e.clientX, e.clientY);
    const node = at?.offsetNode ?? range?.startContainer;
    const offset = at?.offset ?? range?.startOffset ?? 0;
    let shown;
    if (node && left.contains(node)) shown = left.textContent.slice(0, offset);
    else if (node && right.contains(node)) shown = left.textContent + right.textContent.slice(0, offset);
    else {
      // beside the text (the empty part of the line): the nearer end
      const box = el.querySelector(".text").getBoundingClientRect();
      shown = e.clientX < box.left ? "" : left.textContent + right.textContent;
    }
    moveTo(shownToCaret(shown));
  };
  effect(() => {
    const on = copied() !== null;
    sessions();   // new displays get the state too
    for (const b of track.querySelectorAll(".copy")) b.toggleAttribute("data-copied", on);
  });

  // ###################
  // Two-finger swipe (sideways wheel): one session per swipe, then wait for the swipe to end
  // ###################
  let swiped = 0;
  let resting = null;
  track.addEventListener("wheel", (e) => {
    if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;   // only sideways swipes move between sessions
    e.preventDefault();
    clearTimeout(resting);
    resting = setTimeout(() => (swiped = 0), 200);
    if (swiped === Infinity) return;
    swiped += e.deltaX;
    if (Math.abs(swiped) > 60) {
      go(current() + Math.sign(swiped));
      swiped = Infinity;
    }
  }, { passive: false });
}$

[div = class: "viewport"]
  [div = class: "track", arcm-ref: "track"][end]
[end]
# one session's display; cloned per session
[template = arcm-ref: "display"]
  [section = class: "display"]
    [div = class: "line"][span = class: "text"][span = class: "left"]0[end][span = class: "cursor"][end][span = class: "right"][end][end][end]
    [div = class: "result"]
      [button = class: "copy", type: "button", tabindex: "-1", aria-label: "Copy", title: "Copy (Ctrl+C)"]
        [span = class: "i-copy"][Icon = name: "copy", size: 15 !][end]
        [span = class: "i-check"][Icon = name: "check", size: 15 !][end]
      [end:button]
      [span = class: "value"]= [span = class: "result-text"][end][end]
    [end:div]
  [end:section]
[end:template]

[style]
  .viewport {
    flex: 1;
    min-height: 0;
    margin: 0 -16px;
    overflow: hidden;
  }
  .track {
    display: flex;
    height: 100%;
  }
  .track[data-ready] {
    transition: transform 0.2s ease-out;
  }

  /* ###################
     One session's display
     ################### */
  .display {
    flex: 0 0 100%;
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 16px;
    text-align: right;
  }
  .line {
    min-height: 0;
    margin-top: 8px;
    font-size: 36px;
    line-height: 1.2;
    color: var(--ink);
    overflow-wrap: anywhere;
    overflow-y: auto;
    scrollbar-width: none;
    cursor: text;
  }
  .display[data-empty] .line {
    cursor: default;
  }
  .display[data-empty] .line {
    color: color-mix(in srgb, var(--orbit) 50%, transparent);
  }
  .cursor {
    display: none;
    width: 2px;
    height: 0.9em;
    margin-left: 2px;
    vertical-align: -0.1em;
    background: var(--active);
    animation: blink 1s steps(1) infinite;
  }
  .display[data-current] .cursor {
    display: inline-block;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .result {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    min-height: 1.4em;
    font-size: 22px;
    color: var(--result);
  }
  .value {
    visibility: hidden;
  }
  .display[data-show] .value {
    visibility: visible;
  }

  /* copy: shown when there's something to copy, in the current display only */
  .copy {
    display: none;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    color: color-mix(in srgb, var(--orbit) 70%, transparent);
    background: none;
    border: 0;
    border-radius: 8px;
    cursor: pointer;
  }
  .display[data-current][data-copy] .copy {
    display: grid;
  }
  .copy:hover {
    color: var(--orbit);
    background: var(--surface);
  }
  .copy:focus {
    outline: none;
  }
  .i-copy {
    display: flex;
  }
  .i-check,
  .copy[data-copied] .i-copy {
    display: none;
  }
  .copy[data-copied] .i-check {
    display: flex;
    color: var(--active);
  }

  /* short windows: smaller text, so the line and its result always show */
  @media (max-height: 520px) {
    .line {
      font-size: 28px;
    }
    .result {
      font-size: 18px;
    }
  }
[end]
